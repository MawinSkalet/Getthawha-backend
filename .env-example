# Copy this template to .env and fill in values for your environment.
# Never use these example URLs or empty secret values in production.
NODE_ENV=dev
PORT=8000
DOMAIN=http://localhost:8000
HOST=localhost
DATABASE=getthawa
USER_DB=postgres
PASSWORD=

# Required by the backend and admin frontend. Generate a long random value and
# use the same value in both repos.
JWT_SECRET=

# Browser origins allowed to call the API. Production must list every owned
# frontend origin explicitly.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=
REDIRECT_URI_AFTER_LOGIN=http://localhost:3000

# Google sign-in (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/authorization

# LINE Login (optional).
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/line/authorization
CLIENT_URL=http://localhost:3000

# LINE push notifications (optional).
MESSAGE_CHANNEL_ACCESS_TOKEN=

# Facebook Messenger integration (optional).
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=

# Email notifications (optional).
EMAIL=
CUSTOM_EMAIL=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
OWNER_NOTIFICATION_EMAILS=
