# Merge into the production backend environment.
# Replace example.com with your owned domain. Use a SEPARATE Google OAuth client.
NODE_ENV=production
FRONTEND_ORIGIN=https://www.example.com
REDIRECT_URI_AFTER_LOGIN=https://www.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/google/authorization
COOKIE_DOMAIN=.example.com
JWT_SECRET=
# Keep your production database configuration in the same environment.
